version: 1.0.0
date-released: 2026-11-25
repository-code: "https://github.com/takechanman1228/translate-bench"
url: "https://github.com/takechanman1228/translate-bench"
license: Apache-2.0
keywords:
  - machine translation
  - benchmark
  - evaluation
  - local models
